#!/bin/sh
# Managed by Ansible (role debian-k3s). Puts every power knob this box has into performance
# mode. Prints CHANGED only if it altered something, so callers can report idempotently.
changed=0

set_if() {  # file wanted
    [ -w "$1" ] || return 0
    [ "$(cat "$1")" = "$2" ] && return 0
    echo "$2" > "$1" 2>/dev/null && [ "$(cat "$1")" = "$2" ] && changed=1
    return 0
}
has_word() {  # file word
    [ -r "$1" ] && case " $(cat "$1") " in *" $2 "*) return 0 ;; esac
    return 1
}

for d in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    [ -d "$d" ] || continue
    has_word "$d/scaling_available_governors" performance && set_if "$d/scaling_governor" performance
    has_word "$d/energy_performance_available_preferences" performance && set_if "$d/energy_performance_preference" performance
done

if has_word /sys/firmware/acpi/platform_profile_choices performance; then
    set_if /sys/firmware/acpi/platform_profile performance
fi

if command -v powerprofilesctl >/dev/null 2>&1; then
    if [ "$(powerprofilesctl get 2>/dev/null)" != performance ]; then
        powerprofilesctl set performance 2>/dev/null && changed=1
    fi
fi

[ "$changed" = 1 ] && echo CHANGED
exit 0
