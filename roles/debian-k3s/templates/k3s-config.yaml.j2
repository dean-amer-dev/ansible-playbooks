# Managed by Ansible (role debian-k3s) -- do not edit by hand.
node-name: {{ inventory_hostname }}
node-ip: {{ debian_k3s_node_ip }}
write-kubeconfig-mode: "0600"
{% if inventory_hostname == debian_k3s_init_host %}
cluster-init: true
{% else %}
server: https://{{ hostvars[debian_k3s_init_host].debian_k3s_node_ip | default(hostvars[debian_k3s_init_host].ansible_host) }}:6443
{% endif %}
{% if debian_k3s_token | length > 0 %}
token: "{{ debian_k3s_token }}"
{% endif %}
flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true
disable:
  - servicelb
  - traefik
  - local-storage
  - coredns
cluster-cidr: {{ debian_k3s_cluster_cidr }}
service-cidr: {{ debian_k3s_service_cidr }}
cluster-dns: {{ debian_k3s_cluster_dns }}
tls-san:
  - {{ debian_k3s_api_hostname }}
{% for san in debian_k3s_extra_tls_sans %}
  - {{ san }}
{% endfor %}
etcd-expose-metrics: true
etcd-snapshot-schedule-cron: "{{ debian_k3s_etcd_snapshot_schedule }}"
etcd-snapshot-retention: {{ debian_k3s_etcd_snapshot_retention }}
kubelet-arg:
  - kube-reserved={{ debian_k3s_kube_reserved }}
  - system-reserved={{ debian_k3s_system_reserved }}
  - eviction-hard={{ debian_k3s_eviction_hard }}
